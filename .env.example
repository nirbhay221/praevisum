# Vertex AI (preferred) - or set GOOGLE_API_KEY for the Gemini API instead
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Live-capable model for the phone conversation
PRAEVISUM_LIVE_MODEL=gemini-live-2.5-flash-preview-native-audio
# Cheaper text model for the background specialists
PRAEVISUM_WORKER_MODEL=gemini-2.5-flash

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public wss:// base for the media stream, e.g. wss://abc123.ngrok.app
PUBLIC_WS_BASE=

# Dealer identity used in the greeting / AI disclosure
PRAEVISUM_DEALER_NAME=Midwest Commercial Refrigeration
